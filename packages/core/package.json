{
  "name": "@kanithanj/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, browser-safe job matching core for kanithanj.ai. No network, no AI calls.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@adaptate/core": "2.2.2",
    "effect": "4.1.5",
    "neverthrow": "8.2.0",
    "ts-pattern": "5.9.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "^4.3.0",
    "typescript": "5.9.3"
  }
}
