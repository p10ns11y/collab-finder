{
  "name": "collab-finder",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @kanithanj/desktop dev",
    "build": "pnpm --filter @kanithanj/desktop build",
    "build:web": "pnpm --filter @kanithanj/desktop build:web",
    "type-check": "pnpm --filter @kanithanj/desktop type-check",
    "preview": "pnpm --filter @kanithanj/desktop preview",
    "tauri": "tauri",
    "verify": "node scripts/run-verify.mjs",
    "check:client-leak": "node --test scripts/ci-client-leak.test.mjs && node scripts/ci-client-leak.mjs",
    "mutate:xai-panel": "pnpm --filter @kanithanj/desktop mutate:xai-panel",
    "ci-check": "bash scripts/ci-check.sh",
    "ci-check-light": "bash scripts/ci-check-light.sh",
    "gate": "bash scripts/gate.sh",
    "export-pipeline": "node scripts/export-pipeline.mjs",
    "pulse-export": "node scripts/pulse-export.mjs",
    "pulse-import": "node scripts/pulse-import.mjs",
    "firm-list": "node scripts/generate-firm-list.mjs",
    "backup-db": "bash scripts/backup-db.sh",
    "complexity": "bash scripts/ci-complexity.sh",
    "install:local": "tauri build --no-bundle && install -m 755 src-tauri/target/release/collab-finder \"$HOME/.local/bin/kanithanj.ai\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2"
  }
}
