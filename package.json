{
  "name": "collab-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify": "node scripts/run-verify.mjs",
    "ci-check": "bash scripts/ci-check.sh",
    "ci-check-light": "bash scripts/ci-check-light.sh",
    "gate": "bash scripts/gate.sh",
    "complexity": "bash scripts/ci-complexity.sh",
    "install:local": "tauri build --no-bundle && install -m 755 src-tauri/target/release/collab-finder \"$HOME/.local/bin/kanithanj.ai\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
