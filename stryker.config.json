{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --experimental-strip-types --no-warnings src/core/domain/xai-key-panel.verify.runner.mjs"
  },
  "mutate": ["src/core/domain/xai-key-panel.ts"],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 60000,
  "reporters": ["clear-text", "progress"],
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [".stryker-tmp", "node_modules"]
}
