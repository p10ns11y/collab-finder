      "include": [
        "src-tauri/src/research_ingest.rs",
        "src-tauri/src/bin/**",
        "src-tauri/fixtures/**"
      ]
    },
    {
      "id": "network",
      "include": [
        "src-tauri/src/network_graph.rs",
        "src/core/domain/network-graph.ts",
        "src/view/screens/network-screen.tsx",
        "data/connections.sample.csv",
        "data/contacts.sample.csv",
        "data/network-csv.md"
      ]
    },
    {
      "id": "hire-board",
      "include": [
        "src-tauri/src/hire_board.rs",
        "src/core/domain/hire-board.ts",
        "src/components/finder/hire-board-panel.tsx",
        "data/hire-board/**"
