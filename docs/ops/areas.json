      "include": [
        "src-tauri/src/db.rs",
        "src-tauri/src/app_dirs.rs",
        "src-tauri/src/pulse.rs",
        "scripts/backup-db.sh",
        "scripts/pulse-export.mjs",
        "scripts/pulse-import.mjs",
        "scripts/seed-testdata-for-ci.sh"
