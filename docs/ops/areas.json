{
  "areas": [
    {
      "id": "shell",
      "include": [
        "src/main.tsx",
        "src/App.tsx",
        "src/vite-env.d.ts",
        "src/app/**",
        "src/shell/**",
        "src/lib/**",
        "src/index.css",
        "src/types/**",
        "src/view/finder-app-view.tsx",
        "src/view/screens/heading-screen.tsx",
        "src/components/layout/**",
        "src/components/ui/**",
        "src/components/finder/command-palette.tsx",
        "src/components/finder/error-banner.tsx",
        "src/core/domain/finder-nav*",
        "src/core/domain/finder-keyboard*",
        "src/core/domain/heading-*",
        "index.html"
      ]
