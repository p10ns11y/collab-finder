    {
      "id": "profile-data",
      "include": ["data/distillation/**", "scripts/prune-public-projects.mjs"],
      "exclude": ["data/distillation/x-search/**"]
    },
    {
      "id": "ops",
      "include": [
        ".github/**",
        "scripts/ci-*",
        "scripts/run-verify.mjs",
        "scripts/cut-release.sh",
        "scripts/ensure-lizard.sh",
        "scripts/sync-agent-skills.sh",
        "scripts/gate.sh",
        "scripts/area-map*",
        "dx/**",
        "package.json",
        "pnpm-lock.yaml",
        "src-tauri/Cargo.*",
        "src-tauri/icons/**",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.ts",
        "postcss.config.js",
        "stryker.config.json",
        ".gitignore",
        "src-tauri/.gitignore",
        "session-sot.example",
        "skills-lock.json"
      ]
    },
    {
      "id": "docs",
      "include": ["**/*.md", "docs/**", ".agents/**", ".grok/**", "archive/**"],
      "exclude": ["docs/qa/**", "data/**", "vendor/**", ".github/**", "src-tauri/tests/**"]
    }
  ]
}
